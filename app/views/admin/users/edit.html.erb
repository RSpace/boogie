<div class="page-header">
  <h1>Redigerer bruger: <%= @user.username %></h1>
</div>

<%= form_for([:admin, @user]) do |f| %>
  <% if @user.errors.any? %>
    <div id="error_explanation" class="info-box bg-danger text-danger">
      <h4><%= @user.errors.count %> fejl forhindrede brugeren i at blive gemt:</h4>

      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :email, 'Email' %><br>
    <%= f.text_field :email, :class => 'form-control' %>
    <div class="help-text">Når du har sat eller ændret en brugers email, bør du bede dem om at nulstille deres kodeord via "Glemt kodeord" funktionen på login-siden. Du kan ikke se eller ændre kodeordet for en bruger direkte.</div>
  </div>

  <%= f.submit 'Gem user', :class => 'btn btn-default' %>
<% end %>


<%= link_to 'Tilbage', admin_users_path %>
