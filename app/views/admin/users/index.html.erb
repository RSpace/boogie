<div class="page-header">
  <h1>Brugere</h1>
</div>

<% if @users.empty? %>
  <p>Ingen brugere oprettet</p>
<% else %>
  <table class="table table-striped">
    <tr>
      <th>Brugernavn</th>
      <th>Email</th>
      <th>Rolle</th>
      <th>Sidst logget ind</th>
      <th>Handlinger</th>
    </tr>
    <% for user in @users %>
      <tr>
        <td><%= user.username %></td>
        <td><%= link_to_if user.email?, user.email, "mailto:#{user.email}" %></td>
        <td><%= user.admin? ? "Administrator" : "Husstand" %></td>
        <td><%= user.current_sign_in_at? ? l(user.current_sign_in_at, format: BOOGIE_SETTINGS[:date_format]) : "Aldrig" %></td>
        <td>
          <%= link_to 'Rediger', edit_admin_user_path(user) %>
        </td>
      </tr>
    <% end %>
  </table>
<% end %>
